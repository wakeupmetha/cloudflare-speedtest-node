# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env files — secrets, never commit.
.env
.env.local
.env.*.local

# Runtime data — history.ndjson lives in $DATA_DIR (default ./data).
# Each agent writes a different file; never commit per-host state.
data/
*.ndjson

# OS noise
.DS_Store
Thumbs.db

# Claude Code per-session worktrees — ephemeral, per-user, never commit.
.claude/worktrees/

# Per-developer Claude Code permission allow-list — never shared
.claude/settings.local.json
