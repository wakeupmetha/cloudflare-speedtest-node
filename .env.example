# Per-node identity. Use the same name the Remnawave panel knows the
# node by (e.g. de-fra-1) — the CRM joins speedtest results onto the
# /nodes card by this exact string.
SERVER_ID=de-fra-1

# Per-node JWT issued by the aerio CRM. Generate it in /nodes on the
# panel: open the node card, click the small key icon next to the
# "Speedtest" row, then "Generate" (or "Rotate"). The token is shown
# once — paste the whole value here, then `docker compose up -d` to
# pick it up. Different on every node.
AUTH_TOKEN=paste-the-jwt-from-the-panel

# Public port on the host. The CRM reads from
# https://<this-host>:<PUBLIC_PORT>/speedtest/*. 9101 sits in the
# Prometheus exporter range (next to node_exporter on 9100) — leave it
# unless something else is already bound to 9101 on this VPS.
PUBLIC_PORT=9101

# Cadence between scheduled runs, ms. 30 min is what the panel expects.
INTERVAL_MS=1800000

# ±N % jitter applied to each interval so a fleet of agents booted in
# the same window doesn't all fire at the same second.
JITTER_PCT=0.15

# Speedtest knobs — defaults are tuned for traffic-economical 30 min
# runs. Bump for higher fidelity at the cost of upstream bandwidth.
CONCURRENCY=4
DOWNLOAD_SEC=5
UPLOAD_SEC=5
LATENCY_SAMPLES=20

# Persisted history cap (rows). 1500 × 30 min ≈ 31 days at default cadence.
MAX_HISTORY=1500
