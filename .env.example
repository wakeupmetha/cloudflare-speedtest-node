# ── Pairing (the two values the panel's install dialog fills in) ────────────

# The panel this agent reports to. Empty = standalone mode: the agent still
# measures and serves results on its local API, but nothing is pushed.
PANEL_URL=https://console.aerio.my

# Per-node secret minted on the panel's /nodes page ("Generate token").
# The panel resolves this to the node's name — the agent never states its
# own name. REQUIRED: the agent refuses to start without it.
TOKEN=

# ── Cadence ─────────────────────────────────────────────────────────────────

# Heartbeat to the panel (30 s, floor 5 s). Also sent after every run.
# HEARTBEAT_MS=30000

# Speedtest cadence (30 min, floor 60 s) and ±jitter so a fleet does not
# fire in lock-step. First run FIRST_DELAY_MS after boot.
INTERVAL_MS=1800000
JITTER_PCT=0.15
# FIRST_DELAY_MS=5000

# Service-availability checks (remnawave/geocheck): every 6 h, floor 10 min,
# 0 disables. First run 60 s after boot.
GEOCHECK_INTERVAL_MS=21600000
# Path to the binary; the docker image bundles it. Bare installs: put
# geocheck on PATH (https://github.com/remnawave/geocheck) or point here.
# GEOCHECK_BIN=geocheck
# Extra flags after `--json --quiet`. Default skips path analysis and
# tunnel detection (they need NET_RAW and take minutes) and probes IPv4.
# GEOCHECK_ARGS=--no-mtr --no-detect -4 -t 8

# ── Measurement (defaults are traffic-economical; upstream uses 10 s × 6) ───

CONCURRENCY=4
DOWNLOAD_SEC=5
UPLOAD_SEC=5
# Idle-latency window and probe cadence (cloudflare-speed-cli defaults).
# LATENCY_SEC=2
# PROBE_INTERVAL_MS=250
# PROBE_TIMEOUT_MS=2000
# DOWNLOAD_BYTES_PER_REQ=10000000
# UPLOAD_BYTES_PER_REQ=5000000

# ── Local API / storage / logs ──────────────────────────────────────────────

# Loopback by default — the panel never reads it. BIND=0.0.0.0 to expose.
# PORT=9101
# BIND=127.0.0.1

# Where history.ndjson and geocheck.json live (docker: /data on the volume).
# DATA_DIR=./data
# DATA_FILE=${DATA_DIR}/history.ndjson

# Rows kept (1500 × 30 min ≈ 31 days).
MAX_HISTORY=1500

# none|debug|info|warn|error — same vocabulary as the panel. LOG_JSON=1 for
# one JSON object per line; LOG_COLOR=0 / NO_COLOR=1 to strip colour.
LOG_LEVEL=info
# Service name in the JSON line (the console omits it).
# LOG_SERVICE=aerio-agent
