# The node identifies itself by its public IP + location, looked up once
# at boot via ip-api.com — there is no manual identity to configure.

# Shared secret checked on every request (Authorization: Bearer <TOKEN>).
# Just an operator-set secret — generate your own, keep it private to
# this node:  openssl rand -hex 24
# REQUIRED: the agent refuses to start with an empty TOKEN, so it can't
# accidentally come up as an open API on a public port.
TOKEN=change-me-openssl-rand-hex-24

# Public port on the host. Requests from any consumer hit
# https://<this-host>:<PUBLIC_PORT>/speedtest/*. 9101 sits in the
# Prometheus exporter range (next to node_exporter on 9100) — leave it
# unless something else is already bound to 9101 on this VPS.
PUBLIC_PORT=9101

# Cadence between scheduled runs, ms. 30 min is a sensible default.
INTERVAL_MS=1800000

# ±N % jitter applied to each interval so a fleet of agents booted in
# the same window doesn't all fire at the same second.
JITTER_PCT=0.15

# Speedtest knobs — defaults are tuned for traffic-economical 30 min
# runs. Bump for higher fidelity at the cost of upstream bandwidth.
CONCURRENCY=4
DOWNLOAD_SEC=5
UPLOAD_SEC=5
LATENCY_SAMPLES=20

# Persisted history cap (rows). 1500 × 30 min ≈ 31 days at default cadence.
MAX_HISTORY=1500
